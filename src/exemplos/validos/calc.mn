val int x;
val int y;
val int soma = 0;
val string opcao;

print "Digite primeiro numero";
out x;
print "Digite segundo numero";
out y;
print "Digite + - * /";
out opcao;

if opcao == "+" {
    soma = x + y;
}
elif opcao == "-" {
    soma = x - y;
}
elif opcao == "*" {
    soma = x * y;
}
elif opcao == "/" {
    if y != 0 {
        soma = x / y;
    } else {
        print "Erro: divisao por zero";
    }
}

print "O resultado e", soma;
