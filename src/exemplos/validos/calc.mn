./Programa de Calculadora Simple

fn calculadora {
       val int x;
       val int y; 
       val string opcao;
       val int soma = 0;

       print "Digite o x";
       out x;
       print "Digite o y ";
       out y;
       print "Digite + - * / ";
       out opcao;

       if opcao == "+" {
          soma = x + y;
       }
       elif opcao == "-" {
          soma = x - y; 
       }
       elif opcao == "*" {
          soma = x * y;
       }
       elif opcao == "/" {
           soma = x / y;
       }

       print "A operacao resulta em", soma;
}
