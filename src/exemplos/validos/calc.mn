./ Programa de Calculadora Simples Corrigido

fn calculadora {
       val int x;
       val int y;
       val string opcao;
       val int soma = 0;

       print "Digite o x";
       out x;
       print "Digite o y ";
       out y;
       print "Digite + - * / ";
       out opcao;

       if opcao == "+" {
          soma = x + y;
       }
       elif opcao == "-" {
          soma = x - y;
       }
       elif opcao == "*" {
          soma = x * y;
       }
       elif opcao == "/" {
            if y != 0 {
               soma = x / y;
            } else {
               print "Erro divisao por zero";
            }
       }

       print "A soma é", soma;
}