options {
  STATIC = false;
}

PARSER_BEGIN(MiniNova)
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.InputStream;
import java.io.ByteArrayInputStream;
import java.nio.charset.StandardCharsets;
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class MiniNova {

  public static Object resultado = 0.0;
  public static Map<String, Object> memoria = new HashMap<String, Object>();
  public static Scanner scanner = new Scanner(System.in);
  public static boolean executing = true;

  private static double toDouble(Object o) {
    if (o instanceof Number) {
      return ((Number) o).doubleValue();
    }
    try {
      return Double.parseDouble(o.toString());
    } catch (Exception e) {
      return 0.0;
    }
  }

  private static String formatVal(Object val) {
    if (val == null) return "none";
    if (val instanceof Double) {
      double d = (Double) val;
      if (d == (long) d) {
        return String.valueOf((long) d);
      }
    }
    return val.toString();
  }

  private static String toStr(Object o) {
    if (o == null) return "none";
    return String.valueOf(o);
  }

  public static void main(String[] args) throws Exception {
    InputStream in = null;
    String origem = "";

    try {
      if (args.length == 1) {
        origem = "Arquivo: " + args[0];
        in = new FileInputStream(args[0]);
      } else {
        origem = "Entrada Padrão (Console)";
        in = System.in;
      }

      System.out.println("----------------------------------------");
      System.out.println(" MiniNova - Compilador iniciado!");
      System.out.println("Digite seu código e aperte Enter.");
      System.out.println("Para sair, aperte Ctrl+Z (Windows) ou Ctrl+D (Linux/Mac) e Enter.");
      System.out.println(" " + origem);
      System.out.println("----------------------------------------");

      MiniNova parser = new MiniNova(in);
      parser.programa();

      System.out.println("\n=> Sintaxe Correta!");

    } catch (FileNotFoundException e) {
      System.out.println("\n[ERRO] Arquivo nao encontrado: " + (args.length > 0 ? args[0] : ""));
    } catch (ParseException e) {
      System.out.println("\n[ERRO] Erro de Sintaxe encontrado!");
      System.out.println(e.getMessage());
    } catch (TokenMgrError e) {
      System.out.println("\n[ERRO] Erro Lexico (simbolo invalido) encontrado!");
      System.out.println(e.getMessage());
    } finally {
      if (args.length == 1 && in != null) {
        try { in.close(); } catch (Exception ignore) {}
      }
    }
  }
}

PARSER_END(MiniNova)

SKIP : {
  " " | "\t" | "\r" | "\n"
| <COMENTARIO: "./" (~["\n", "\r"])*>
}

TOKEN : {
  <KW_VAL: "val">  | <KW_PRINT: "print"> | <KW_OUT: "out">
| <KW_IF: "if"> | <KW_ELIF: "elif"> | <KW_ELSE: "else">
| <KW_FOR: "for"> 
| <KW_AND: "and"> | <KW_OR: "or">
| <T_INT: "int"> | <T_FLOAT: "float"> | <T_STRING: "string"> | <T_BOOL: "bool">
| <KW_TRUE: "true"> | <KW_FALSE: "false"> | <KW_NONE: "none">
}

TOKEN : {
  <POT: "**"> | <MAIS: "+"> | <MENOS: "-"> | <MULT: "*"> | <DIV: "/"> | <MOD: "%">
| <IGUAL: "=="> | <DIF: "!="> | <MENORIG: "<="> | <MAIORIG: ">="> | <MENOR: "<"> | <MAIOR: ">">
| <ATRIB: "=">  | <PV: ";"> | <ACH: "{"> | <FCH: "}">
| <APAR: "("> | <FPAR: ")"> | <VIRGULA: ",">
}

TOKEN : {
  <NUM_INT: (["0"-"9"])+>
| <NUM_FLOAT: (["0"-"9"])+ "." (["0"-"9"])+>
| <STRING_LIT: "\"" (~["\"", "\n", "\r"])* "\"">
| <ID: ["a"-"z", "A"-"Z", "_"] (["a"-"z", "A"-"Z", "0"-"9", "_"])*>
}

void programa() : {} {
  ( comando() )*
  <EOF>
}

void bloco() : {} { <ACH> ( comando() )* <FCH> }

void comando() : {} {
  declaracao()
| LOOKAHEAD(2) atribuicao()
| chamada()
| leitura()
| escrita()
| condicional()
| para()
}

void declaracao() : { Token id; Object val = 0.0; } {
  <KW_VAL>
  (
    LOOKAHEAD(2) tipo() id=<ID>
  |
    id=<ID> [ tipo() ]
  )
  [ <ATRIB> val=expressao() {
      if (executing) {
        memoria.put(id.image, val);
        resultado = val;
      }
    }
  ]
  <PV>
}

void tipo() : {} { <T_INT> | <T_FLOAT> | <T_STRING> | <T_BOOL> }

void atribuicao() : {} { atribSemPV() <PV> }

void atribSemPV() : { Token id; Object val; } {
  id=<ID> <ATRIB> val=expressao() {
    if (executing) {
      memoria.put(id.image, val);
      resultado = val;
    }
  }
}

void chamada() : {} { <ID> [ listaArgumentos() ] <PV> }
void listaArgumentos() : {} { expressao() ( expressao() )* }

void leitura() : { Token id; } {
  <KW_OUT> id=<ID> <PV> {
    if (executing) {
      if (scanner.hasNextDouble()) {
        double d = scanner.nextDouble();
        memoria.put(id.image, d);
        resultado = d;
      } else {
        String s = scanner.next();
        memoria.put(id.image, s);
        resultado = s;
      }
    }
  }
}

void escrita() : { Object val; StringBuilder sb = new StringBuilder(); } {
  <KW_PRINT> val=expressao() {
    if (executing) {
      sb.append(formatVal(val));
      resultado = val;
    }
  }
  ( <VIRGULA> val=expressao() {
    if (executing) {
      sb.append(" ").append(formatVal(val));
      resultado = val;
    }
  } )*
  {
    if (executing) {
      System.out.println(sb.toString());
    }
  }
  <PV>
}

void condicional() : {
  Object cond;
  boolean parentExec = executing;
  boolean branchTaken = false;
} {
  <KW_IF> cond=expressao()
  {
    branchTaken = (toDouble(cond) != 0);
    executing = parentExec && branchTaken;
  }
  bloco()
  (
    LOOKAHEAD(2)
    <KW_ELIF> cond=expressao()
    {
      if (!branchTaken && toDouble(cond) != 0) {
        branchTaken = true;
        executing = parentExec;
      } else {
        executing = false;
      }
    }
    bloco()
  )*
  [
    <KW_ELSE>
    {
      executing = parentExec && !branchTaken;
    }
    bloco()
  ]
  {
    executing = parentExec;
  }
}

void blocoInterno() : {} { ( comando() )* }

void para() : {
  Token id;
  Object limite;
  boolean parentExec = executing;
  StringBuilder blockCode = new StringBuilder();
  Token t;
  int depth = 0;
} {
  <KW_FOR> id=<ID> limite=expressao()
  <ACH> {
    depth = 1;
  }
  (
    LOOKAHEAD({ depth > 0 })
    (
      t = <ACH> { depth++; blockCode.append(" {").append(" "); }
    |
      t = <FCH> { depth--; if (depth > 0) blockCode.append(" }").append(" "); }
    |
      t = <KW_VAL> { blockCode.append("val").append(" "); }
    |
      t = <KW_PRINT> { blockCode.append("print").append(" "); }
    |
      t = <KW_OUT> { blockCode.append("out").append(" "); }
    |
      t = <KW_IF> { blockCode.append("if").append(" "); }
    |
      t = <KW_ELIF> { blockCode.append("elif").append(" "); }
    |
      t = <KW_ELSE> { blockCode.append("else").append(" "); }
    |
      t = <KW_FOR> { blockCode.append("for").append(" "); }
    |
      t = <KW_AND> { blockCode.append("and").append(" "); }
    |
      t = <KW_OR> { blockCode.append("or").append(" "); }
    |
      t = <T_INT> { blockCode.append("int").append(" "); }
    |
      t = <T_FLOAT> { blockCode.append("float").append(" "); }
    |
      t = <T_STRING> { blockCode.append("string").append(" "); }
    |
      t = <T_BOOL> { blockCode.append("bool").append(" "); }
    |
      t = <KW_TRUE> { blockCode.append("true").append(" "); }
    |
      t = <KW_FALSE> { blockCode.append("false").append(" "); }
    |
      t = <KW_NONE> { blockCode.append("none").append(" "); }
    |
      t = <POT> { blockCode.append("**").append(" "); }
    |
      t = <MAIS> { blockCode.append("+").append(" "); }
    |
      t = <MENOS> { blockCode.append("-").append(" "); }
    |
      t = <MULT> { blockCode.append("*").append(" "); }
    |
      t = <DIV> { blockCode.append("/").append(" "); }
    |
      t = <MOD> { blockCode.append("%").append(" "); }
    |
      t = <IGUAL> { blockCode.append("==").append(" "); }
    |
      t = <DIF> { blockCode.append("!=").append(" "); }
    |
      t = <MENORIG> { blockCode.append("<=").append(" "); }
    |
      t = <MAIORIG> { blockCode.append(">=").append(" "); }
    |
      t = <MENOR> { blockCode.append("<").append(" "); }
    |
      t = <MAIOR> { blockCode.append(">").append(" "); }
    |
      t = <ATRIB> { blockCode.append("=").append(" "); }
    |
      t = <PV> { blockCode.append(";").append(" "); }
    |
      t = <VIRGULA> { blockCode.append(",").append(" "); }
    |
      t = <APAR> { blockCode.append("(").append(" "); }
    |
      t = <FPAR> { blockCode.append(")").append(" "); }
    |
      t = <NUM_INT> { blockCode.append(t.image).append(" "); }
    |
      t = <NUM_FLOAT> { blockCode.append(t.image).append(" "); }
    |
      t = <STRING_LIT> { blockCode.append(t.image).append(" "); }
    |
      t = <ID> { blockCode.append(t.image).append(" "); }
    )
  )* {
    if (executing) {
      double maxVal = toDouble(limite);
      for (double i = 0; i < maxVal; i++) {
        memoria.put(id.image, i);
        try {
          MiniNova subParser = new MiniNova(new ByteArrayInputStream(blockCode.toString().getBytes(StandardCharsets.UTF_8)));
          subParser.blocoInterno();
        } catch (Exception e) {
          break;
        }
      }
    }
    executing = parentExec;
  }
}

Object expressao() : { Object r; } { r=ou() { return r; } }

Object ou() : { Object r, v; } {
  r=e() ( LOOKAHEAD(2) <KW_OR> v=e() {
    boolean b1 = toDouble(r) != 0;
    boolean b2 = toDouble(v) != 0;
    r = (b1 || b2 ? 1.0 : 0.0);
  } )*
  { return r; }
}

Object e() : { Object r, v; } {
  r=relacional() ( LOOKAHEAD(2) <KW_AND> v=relacional() {
    boolean b1 = toDouble(r) != 0;
    boolean b2 = toDouble(v) != 0;
    r = (b1 && b2 ? 1.0 : 0.0);
  } )*
  { return r; }
}

Object relacional() : { Object r, v = 0.0; Token op = null; } {
  r=aditiva() [ op=opRel() v=aditiva() {
    if (r instanceof String || v instanceof String) {
      String s1 = toStr(r);
      String s2 = toStr(v);
      if (op.image.equals("==")) r = (s1.equals(s2) ? 1.0 : 0.0);
      else if (op.image.equals("!=")) r = (!s1.equals(s2) ? 1.0 : 0.0);
      else r = 0.0;
    } else {
      double d1 = toDouble(r);
      double d2 = toDouble(v);
      if (op.image.equals("==")) r = (d1 == d2 ? 1.0 : 0.0);
      else if (op.image.equals("!=")) r = (d1 != d2 ? 1.0 : 0.0);
      else if (op.image.equals("<")) r = (d1 < d2 ? 1.0 : 0.0);
      else if (op.image.equals("<=")) r = (d1 <= d2 ? 1.0 : 0.0);
      else if (op.image.equals(">")) r = (d1 > d2 ? 1.0 : 0.0);
      else if (op.image.equals(">=")) r = (d1 >= d2 ? 1.0 : 0.0);
    }
  } ]
  { return r; }
}

Token opRel() : { Token t; } {
  ( t=<IGUAL> | t=<DIF> | t=<MENORIG> | t=<MAIORIG> | t=<MENOR> | t=<MAIOR> )
  { return t; }
}

Object aditiva() : { Object r, v; Token op; } {
  r=mult() (
    LOOKAHEAD(1)
    ( op=<MAIS> v=mult() {
        if (r instanceof String || v instanceof String) {
          r = toStr(r) + toStr(v);
        } else {
          r = toDouble(r) + toDouble(v);
        }
      }
    | op=<MENOS> v=mult() {
        r = toDouble(r) - toDouble(v);
      }
    )
  )*
  { return r; }
}

Object mult() : { Object r, v; Token op; } {
  r=unario() (
    ( op=<MULT> v=unario() { r = toDouble(r) * toDouble(v); }
    | op=<DIV> v=unario() { 
        double d = toDouble(v);
        if (d == 0.0) {
          r = 0.0;
        } else {
          r = toDouble(r) / d; 
        }
      }
    | op=<MOD> v=unario() { 
        double d = toDouble(v);
        if (d == 0.0) {
          System.out.println("\n[ERRO] Modulo por zero!");
          r = 0.0;
        } else {
          r = toDouble(r) % d; 
        }
      } 
    )
  )*
  { return r; }
}

Object unario() : { Object r; } {
  <MENOS> r=unario() { return -toDouble(r); }
  | r=potencia() { return r; }
}

Object potencia() : { Object r, v = 0.0; boolean hasPot = false; } {
  r=fator() [ <POT> v=unario() { hasPot = true; } ]
  { return hasPot ? Math.pow(toDouble(r), toDouble(v)) : r; }
}

Object fator() : { Token t; String s; Object r; } {
  t=<NUM_INT> { return Double.parseDouble(t.image); }
| t=<NUM_FLOAT> { return Double.parseDouble(t.image); }
| t=<STRING_LIT> {
    s = t.image;
    return s.substring(1, s.length() - 1);
  }
| <KW_TRUE> { return 1.0; }
| <KW_FALSE> { return 0.0; }
| <KW_NONE> { return null; }
| <APAR> r=expressao() <FPAR> { return r; }
| t=<ID> {
    if (memoria.containsKey(t.image)) {
      return memoria.get(t.image);
    } else {
      return 0.0;
    }
  }
}
